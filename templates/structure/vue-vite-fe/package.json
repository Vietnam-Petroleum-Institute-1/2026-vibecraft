    "reka-ui": "2.10.3",
    "tailwind-merge": "3.6.0",
    "vee-validate": "4.15.1",
    "vue": "3.5.41",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
